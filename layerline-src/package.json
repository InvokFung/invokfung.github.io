{
  "name": "layerline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "make wasm",
    "fixtures": "tsx scripts/fixtures.ts",
    "test": "npm run fixtures && make test && node --import tsx --test tests/*.test.ts",
    "bench": "tsx scripts/bench.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "all": "npm run wasm && npm test && npm run bench && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
