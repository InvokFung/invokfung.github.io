{
  "name": "onboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/data.ts",
    "eval": "tsx scripts/eval.ts",
    "dev": "vite --port 8774 --strictPort",
    "preview": "vite preview --port 8774 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "all": "npm run data && npm run eval && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
