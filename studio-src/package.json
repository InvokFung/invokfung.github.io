{
  "name": "intonation-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "node e2e/smoke.mjs",
    "metrics": "tsx scripts/metrics.ts",
    "wav": "tsx scripts/make-wav.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/build-info.ts",
    "all": "npm run metrics && npm run build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
